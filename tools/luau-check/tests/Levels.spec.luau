local Levels = require("@shared/Config/Levels")
local t = require("@test")

t.test("xp curve starts at BaseXp and grows", function()
	t.equal(Levels.xpForLevel(1), Levels.BaseXp)
	assert(Levels.xpForLevel(10) > Levels.xpForLevel(9), "curve must increase")
end)

t.test("cap rises with rebirths", function()
	t.equal(Levels.capFor(0), Levels.CapBase)
	t.equal(Levels.capFor(2), Levels.CapBase + 2 * Levels.CapPerRebirth)
end)

t.test("small gain stays on the same level", function()
	local level, xp, gained = Levels.addXp(1, 0, Levels.BaseXp - 1, 20)
	t.equal(level, 1)
	t.equal(xp, Levels.BaseXp - 1)
	t.equal(gained, 0)
end)

t.test("exact gain levels up with no leftover", function()
	local level, xp, gained = Levels.addXp(1, 0, Levels.BaseXp, 20)
	t.equal(level, 2)
	t.equal(xp, 0)
	t.equal(gained, 1)
end)

t.test("big gain levels up several times and keeps the remainder", function()
	local need = Levels.xpForLevel(1) + Levels.xpForLevel(2) + Levels.xpForLevel(3)
	local level, xp, gained = Levels.addXp(1, 0, need + 1, 20)
	t.equal(level, 4)
	t.equal(xp, 1)
	t.equal(gained, 3)
end)

t.test("gains stop at the cap", function()
	local level, xp, gained = Levels.addXp(18, 0, 1e12, 20)
	t.equal(level, 20)
	t.equal(xp, 0)
	t.equal(gained, 2)
end)

t.test("already at cap gains nothing", function()
	local level, xp, gained = Levels.addXp(20, 0, 500, 20)
	t.equal(level, 20)
	t.equal(xp, 0)
	t.equal(gained, 0)
end)

t.test("negative gain is ignored", function()
	local level, xp = Levels.addXp(3, 5, -100, 20)
	t.equal(level, 3)
	t.equal(xp, 5)
end)

t.test("hops bonus is zero at level 1", function()
	t.equal(Levels.hopsBonus(1), 0)
	t.near(Levels.hopsBonus(11), 10 * Levels.HopsBonusPerLevel)
end)
